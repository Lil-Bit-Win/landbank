# Copy this file to .env and adjust values as needed.

# HARDENING FIX: set FLASK_ENV=development for local/dev work. Any other
# value (including leaving it unset) is treated as production, which
# enables DEBUG=False, SESSION_COOKIE_SECURE, and — via run.py's
# assert_production_secret_key() — a hard startup failure if SECRET_KEY
# below is still the shipped default or shorter than 32 characters.
FLASK_ENV=development

# Generate a real one for any non-development environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
DATABASE_URL=sqlite:///csu.db

# Used only by seed.py when creating the initial admin/agent accounts.
SEED_ADMIN_PASSWORD=admin123
SEED_AGENT_PASSWORD=agent123

# Comma-separated list of roles allowed to create/edit Knowledge Base
# articles. Defaults to "admin,agent" (current behavior). Set to "admin"
# to restrict KB editing to admins only.
ALLOWED_KB_EDITOR_ROLES=admin,agent

# Rows per page on the KB and SOP list views/API endpoints.
ITEMS_PER_PAGE=10

# Flask-Limiter global default (login has its own stricter override).
RATELIMIT_DEFAULT=200 per hour;50 per minute

# Explicit rate limit applied to the whole /api/* blueprint (CHECK 5 fix).
API_RATE_LIMIT=60 per minute
